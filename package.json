{
  "name": "dsh-quote-followup",
  "version": "0.2.5",
  "description": "Quote selected Web conversation text into the DeepSeek Harness composer for targeted follow-up turns.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "quote",
    "follow-up"
  ],
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node test/web-repeat-harness.mjs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tr1v3r/dsh-quote-followup.git"
  },
  "homepage": "https://github.com/tr1v3r/dsh-quote-followup#readme",
  "bugs": "https://github.com/tr1v3r/dsh-quote-followup/issues",
  "author": "tr1v3r <tr1v3r@outlook.com> (https://github.com/tr1v3r)",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  }
}
